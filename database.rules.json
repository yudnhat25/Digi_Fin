{
  "rules": {
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    },
    "competition": {
      ".read": true,
      ".write": "auth != null"
    },
    "community": {
      "posts": {
        ".read": true,
        ".indexOn": ["createdAt"],
        "$postId": {
          ".write": "auth != null && (!data.exists() || data.child('userId').val() === auth.uid)",
          ".validate": "newData.hasChildren(['symbol', 'text', 'createdAt'])"
        }
      }
    }
  }
}

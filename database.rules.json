{
  "rules": {
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid",

        "referralCount": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".validate": "newData.isNumber()"
        },
        "referralEarnings": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".validate": "newData.isNumber()"
        }
      }
    },

    "referralCodes": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid",
        ".validate": "newData.isString()"
      }
    },

    "referrals": {
      "$referrerUid": {
        ".read": "auth != null && $referrerUid === auth.uid",
        "$newUid": {
          ".write": "auth != null && $newUid === auth.uid && !data.exists()",
          ".validate": "newData.hasChildren(['joinedAt', 'rewardUsd'])"
        }
      }
    },

    "competition": {
      ".read": true,
      ".write": "auth != null"
    },

    "community": {
      "posts": {
        ".read": true,
        ".indexOn": ["createdAt"],
        "$postId": {
          ".write": "auth != null && (!data.exists() || data.child('userId').val() === auth.uid)",
          ".validate": "newData.hasChildren(['symbol', 'text', 'createdAt'])"
        }
      }
    }
  }
}
